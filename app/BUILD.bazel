load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")
load("@build_bazel_rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
# Version

apple_bundle_version(
    name = "Version",
    build_version = "0.0.1",
    short_version_string = "1.0",
)

# Code

swift_library(
    name = "app.library",
    srcs = glob(["source/**/*.swift"]),
    data = [":PreviewContent"],
    module_name = "app",
    deps = [
        "//Features/Character:CharacterLib",
        "//Features/Auth:AuthLib",
    ],
)

# Packaging

filegroup(
    name = "PreviewContent",
    srcs = glob(["PreviewContent/**"]),
)

ios_application(
    name = "app",
    app_icons = glob(["Assets/Assets.xcassets/AppIcon.appiconset/**"]),
    bundle_id = "com.github.jmlb23.marvel",
    bundle_name = "MarvelApp",
    entitlements = "ios app.entitlements",
    executable_name = "MarvelApp",
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = [":Info.plist"],
    minimum_os_version = "14",
    resources = glob(
        [
            "Assets/Assets.xcassets/**",
        ],
        exclude = ["Assets/Assets.xcassets/AppIcon.appiconset/**"],
    ),
    # Add localizable assets here.
    # strings = glob(["*.lproj/Localizable.strings"]),
    version = ":Version",
    visibility = [
        "//:__subpackages__",
        "@rules_xcodeproj//xcodeproj:generated",
    ],
    deps = [
        ":app.library",
    ],
)
