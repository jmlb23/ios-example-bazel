load("@build_bazel_rules_apple//apple:ios.bzl", "ios_unit_test")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
# Code

swift_library(
    name = "CharacterLib",
    srcs = glob(["Sources/*.swift"]),
    module_name = "Character",
    visibility = ["//app:__pkg__"],
)

# Tests

swift_library(
    name = "CharacterTestLib",
    testonly = True,
    srcs = [
        "Tests/CharacterTests.swift",
    ],
    module_name = "APITests",
    deps = [
        ":Character",
    ],
)

ios_unit_test(
    name = "CharacterTests",
    minimum_os_version = "15",
    runner = "//tools:default_test_runner",
    visibility = ["//Features:default_test_visibility"],
    deps = [":CharacterTestLib"],
)
